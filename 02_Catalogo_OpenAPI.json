{
  "openapi": "3.0.4",
  "info": {
    "title": "YouTube - Catálogo editorial y derechos",
    "description": "## Responsabilidad\n\nDefinir **qué contenido existe públicamente**, cómo se presenta y **bajo qué reglas** puede mostrarse (legal, territorial, etaria, moderación).\n\n## Alcance\n\n- **Sí:** canales, metadata editorial, publicación, playlists, derechos, restricciones.\n- **No:** transcoding, ranking de recomendaciones, comentarios, facturación.\n\nAquí el video es un **ítem de catálogo**, no un archivo. Un asset puede existir sin estar publicado. La visibilidad depende de reglas editoriales y legales, no de infraestructura de streaming.\n\n## Integraciones\n\n- Consume: asset técnicamente listo (desde Publicación).\n- Emite: contenido publicado/despublicado/actualizado, restricción aplicada o levantada, reclamación creada o resuelta.",
    "contact": { "email": "catalogo@youtube.example.com" },
    "license": { "name": "Apache 2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0.html" },
    "version": "1.0.0"
  },
  "servers": [ { "url": "/api/v1/catalogo" } ],
  "tags": [
    { "name": "channels", "description": "Gestión de canales (RF-C1)" },
    { "name": "items", "description": "Creación y edición editorial (RF-C2)" },
    { "name": "publication", "description": "Publicación y visibilidad (RF-C3)" },
    { "name": "playlists", "description": "Playlists (RF-C4)" },
    { "name": "rights", "description": "Derechos y reclamaciones (RF-C5)" },
    { "name": "policies", "description": "Políticas y restricciones (RF-C6)" }
  ],
  "paths": {
    "/channels": {
      "post": {
        "tags": ["channels"],
        "summary": "Crear un canal.",
        "description": "RF-C1: Crea un canal asociado a un creador.",
        "operationId": "createChannel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChannelCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canal creado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Channel" }
              }
            }
          },
          "400": { "description": "Datos inválidos." },
          "409": { "description": "El creador ya posee un canal con ese identificador." },
          "default": { "description": "Error inesperado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}": {
      "get": {
        "tags": ["channels"],
        "summary": "Consultar información pública de un canal.",
        "operationId": "getChannel",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Datos del canal.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Channel" }
              }
            }
          },
          "404": { "description": "Canal no encontrado." }
        }
      },
      "patch": {
        "tags": ["channels"],
        "summary": "Actualizar información pública del canal.",
        "description": "RF-C1: Actualizar nombre, descripción, imagen.",
        "operationId": "updateChannel",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChannelUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canal actualizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Channel" }
              }
            }
          },
          "400": { "description": "Datos inválidos." },
          "404": { "description": "Canal no encontrado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/items": {
      "get": {
        "tags": ["channels"],
        "summary": "Listar contenido publicado de un canal.",
        "description": "RF-C1: Lista el contenido publicado de un canal.",
        "operationId": "listChannelItems",
        "parameters": [
          { "$ref": "#/components/parameters/ChannelIdParam" },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Listado de ítems publicados.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogItemPage" }
              }
            }
          }
        }
      }
    },
    "/items": {
      "post": {
        "tags": ["items"],
        "summary": "Crear un ítem de catálogo (borrador).",
        "description": "RF-C2: Vincula un asset técnico con metadata editorial y guarda el contenido como borrador.",
        "operationId": "createCatalogItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CatalogItemCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ítem creado en estado borrador.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogItem" }
              }
            }
          },
          "400": { "description": "Datos inválidos o asset no listo." },
          "default": { "description": "Error inesperado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/items/{catalogItemId}": {
      "get": {
        "tags": ["items"],
        "summary": "Consultar un ítem de catálogo.",
        "operationId": "getCatalogItem",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "responses": {
          "200": {
            "description": "Detalle del ítem.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogItem" }
              }
            }
          },
          "404": { "description": "Ítem no encontrado." }
        }
      },
      "patch": {
        "tags": ["items"],
        "summary": "Editar metadata de un ítem.",
        "description": "RF-C2: Permite editar metadata (título, descripción, tags, categoría, miniatura) de contenido existente.",
        "operationId": "updateCatalogItem",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CatalogItemUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ítem actualizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogItem" }
              }
            }
          },
          "400": { "description": "Datos inválidos." },
          "404": { "description": "Ítem no encontrado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/items/{catalogItemId}/publish": {
      "post": {
        "tags": ["publication"],
        "summary": "Publicar un ítem.",
        "description": "RF-C3: Publica un contenido haciéndolo disponible según las reglas definidas. Notifica a otros contextos.",
        "operationId": "publishCatalogItem",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "responses": {
          "200": {
            "description": "Ítem publicado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogItem" }
              }
            }
          },
          "404": { "description": "Ítem no encontrado." },
          "409": { "description": "Ítem no apto para publicar (asset no listo o políticas pendientes)." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/items/{catalogItemId}/unpublish": {
      "post": {
        "tags": ["publication"],
        "summary": "Despublicar u ocultar un ítem.",
        "description": "RF-C3: Despublica u oculta un contenido y notifica a los demás contextos.",
        "operationId": "unpublishCatalogItem",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "responses": {
          "200": {
            "description": "Ítem despublicado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogItem" }
              }
            }
          },
          "404": { "description": "Ítem no encontrado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/items/{catalogItemId}/visibility": {
      "get": {
        "tags": ["publication"],
        "summary": "Consultar si un ítem es visible para un usuario.",
        "description": "RF-C3: Consulta si un contenido es visible para un usuario según país, edad y estado de moderación. Usado por otros contextos para validaciones síncronas.",
        "operationId": "checkVisibility",
        "parameters": [
          { "$ref": "#/components/parameters/CatalogItemIdParam" },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "age",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado de visibilidad.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VisibilityResult" }
              }
            }
          },
          "404": { "description": "Ítem no encontrado." }
        }
      }
    },
    "/playlists": {
      "post": {
        "tags": ["playlists"],
        "summary": "Crear una playlist.",
        "description": "RF-C4: Crea una colección ordenada de contenidos.",
        "operationId": "createPlaylist",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlaylistCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Playlist creada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Playlist" }
              }
            }
          },
          "400": { "description": "Datos inválidos." }
        },
        "security": [ { "bearerAuth": ["creator", "viewer"] } ]
      }
    },
    "/playlists/{playlistId}": {
      "get": {
        "tags": ["playlists"],
        "summary": "Consultar una playlist con su orden.",
        "description": "RF-C4: Consulta una playlist con su orden.",
        "operationId": "getPlaylist",
        "parameters": [ { "$ref": "#/components/parameters/PlaylistIdParam" } ],
        "responses": {
          "200": {
            "description": "Detalle de la playlist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Playlist" }
              }
            }
          },
          "404": { "description": "Playlist no encontrada." }
        }
      }
    },
    "/playlists/{playlistId}/items": {
      "post": {
        "tags": ["playlists"],
        "summary": "Agregar ítem a la playlist.",
        "description": "RF-C4: Agrega un ítem a la colección.",
        "operationId": "addItemToPlaylist",
        "parameters": [ { "$ref": "#/components/parameters/PlaylistIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlaylistItemAddRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ítem agregado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Playlist" }
              }
            }
          },
          "404": { "description": "Playlist o ítem no encontrado." }
        },
        "security": [ { "bearerAuth": ["creator", "viewer"] } ]
      }
    },
    "/playlists/{playlistId}/items/{catalogItemId}": {
      "delete": {
        "tags": ["playlists"],
        "summary": "Quitar ítem de la playlist.",
        "operationId": "removeItemFromPlaylist",
        "parameters": [
          { "$ref": "#/components/parameters/PlaylistIdParam" },
          { "$ref": "#/components/parameters/CatalogItemIdParam" }
        ],
        "responses": {
          "204": { "description": "Ítem removido." },
          "404": { "description": "Playlist o ítem no encontrado." }
        },
        "security": [ { "bearerAuth": ["creator", "viewer"] } ]
      }
    },
    "/playlists/{playlistId}/reorder": {
      "post": {
        "tags": ["playlists"],
        "summary": "Reordenar ítems de la playlist.",
        "description": "RF-C4: Reordena ítems en una colección.",
        "operationId": "reorderPlaylist",
        "parameters": [ { "$ref": "#/components/parameters/PlaylistIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["orderedItemIds"],
                "properties": {
                  "orderedItemIds": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Playlist reordenada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Playlist" }
              }
            }
          },
          "404": { "description": "Playlist no encontrada." }
        },
        "security": [ { "bearerAuth": ["creator", "viewer"] } ]
      }
    },
    "/items/{catalogItemId}/claims": {
      "post": {
        "tags": ["rights"],
        "summary": "Registrar reclamación de derechos.",
        "description": "RF-C5: Registra una reclamación de derechos sobre un contenido.",
        "operationId": "createClaim",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ClaimCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reclamación creada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Claim" }
              }
            }
          },
          "400": { "description": "Datos inválidos." },
          "404": { "description": "Ítem no encontrado." }
        },
        "security": [ { "bearerAuth": ["rightsHolder"] } ]
      }
    },
    "/claims/{claimId}/resolve": {
      "post": {
        "tags": ["rights"],
        "summary": "Resolver una reclamación.",
        "description": "RF-C5: Permite resolver una reclamación (aceptar, disputar, retirar).",
        "operationId": "resolveClaim",
        "parameters": [
          {
            "name": "claimId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["resolution"],
                "properties": {
                  "resolution": {
                    "type": "string",
                    "enum": ["accepted", "disputed", "withdrawn"]
                  },
                  "comment": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reclamación resuelta.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Claim" }
              }
            }
          },
          "404": { "description": "Reclamación no encontrada." }
        },
        "security": [ { "bearerAuth": ["creator", "rightsHolder", "moderator"] } ]
      }
    },
    "/items/{catalogItemId}/restrictions": {
      "post": {
        "tags": ["policies"],
        "summary": "Aplicar restricción a un contenido.",
        "description": "RF-C6: Aplica restricciones (edad mínima, bloqueo geográfico, limitación de monetización, etc.). También usado como consecuencia de RF-C5.",
        "operationId": "applyRestriction",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RestrictionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Restricción aplicada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Restriction" }
              }
            }
          },
          "404": { "description": "Ítem no encontrado." }
        },
        "security": [ { "bearerAuth": ["moderator"] } ]
      },
      "get": {
        "tags": ["policies"],
        "summary": "Consultar restricciones activas e histórico de política.",
        "description": "RF-C6: Devuelve el historial de estado de política e indica las restricciones vigentes.",
        "operationId": "getRestrictions",
        "parameters": [ { "$ref": "#/components/parameters/CatalogItemIdParam" } ],
        "responses": {
          "200": {
            "description": "Listado de restricciones e historial.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "current": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Restriction" }
                    },
                    "history": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Restriction" }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Ítem no encontrado." }
        }
      }
    },
    "/restrictions/{restrictionId}/lift": {
      "post": {
        "tags": ["policies"],
        "summary": "Levantar una restricción.",
        "operationId": "liftRestriction",
        "parameters": [
          {
            "name": "restrictionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Restricción levantada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Restriction" }
              }
            }
          },
          "404": { "description": "Restricción no encontrada." }
        },
        "security": [ { "bearerAuth": ["moderator"] } ]
      }
    }
  },
  "components": {
    "parameters": {
      "ChannelIdParam": {
        "name": "channelId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "CatalogItemIdParam": {
        "name": "catalogItemId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PlaylistIdParam": {
        "name": "playlistId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSizeParam": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "schemas": {
      "Channel": {
        "type": "object",
        "description": "Entidad editorial: representa un canal como cuenta pública. No incluye conteo de suscriptores (eso vive en Audiencia).",
        "properties": {
          "channelId": { "type": "string" },
          "creatorId": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "avatarUrl": { "type": "string" },
          "bannerUrl": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ChannelCreateRequest": {
        "type": "object",
        "required": ["creatorId", "name"],
        "properties": {
          "creatorId": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ChannelUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "avatarUrl": { "type": "string" },
          "bannerUrl": { "type": "string" }
        }
      },
      "CatalogItem": {
        "type": "object",
        "description": "Ítem de catálogo: el video como producto editorial.",
        "properties": {
          "catalogItemId": { "type": "string" },
          "channelId": { "type": "string" },
          "videoAssetId": { "type": "string", "description": "Referencia al asset técnico en Publicación." },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "thumbnailUrl": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "unpublished"]
          },
          "publishedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CatalogItemCreateRequest": {
        "type": "object",
        "required": ["channelId", "videoAssetId", "title"],
        "properties": {
          "channelId": { "type": "string" },
          "videoAssetId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "thumbnailUrl": { "type": "string" }
        }
      },
      "CatalogItemUpdateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "thumbnailUrl": { "type": "string" }
        }
      },
      "CatalogItemPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CatalogItem" }
          },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "VisibilityResult": {
        "type": "object",
        "properties": {
          "catalogItemId": { "type": "string" },
          "visible": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "example": "geo-blocked-in-CL" }
          }
        }
      },
      "Playlist": {
        "type": "object",
        "properties": {
          "playlistId": { "type": "string" },
          "ownerId": { "type": "string" },
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "catalogItemId": { "type": "string" },
                "position": { "type": "integer" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PlaylistCreateRequest": {
        "type": "object",
        "required": ["ownerId", "title"],
        "properties": {
          "ownerId": { "type": "string" },
          "title": { "type": "string" }
        }
      },
      "PlaylistItemAddRequest": {
        "type": "object",
        "required": ["catalogItemId"],
        "properties": {
          "catalogItemId": { "type": "string" },
          "position": { "type": "integer" }
        }
      },
      "Claim": {
        "type": "object",
        "properties": {
