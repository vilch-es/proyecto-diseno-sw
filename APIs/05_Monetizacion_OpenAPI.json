{
  "openapi": "3.0.4",
  "info": {
    "title": "YouTube - Monetización del ecosistema creador",
    "description": "## Responsabilidad\n\nGestionar **cómo los creadores ganan dinero** y cómo se registran, calculan y pagan esos ingresos.\n\n## Alcance\n\n- **Sí:** elegibilidad, revenue share, membresías de canal, propinas, saldo, payouts, reportes.\n- **No:** crear campañas de anunciantes, recomendar videos, procesar video.\n\nCobra y paga en el ecosistema **creador-espectador**. No negocia con anunciantes ni define qué anuncio se muestra.\n\n## Integraciones\n\n- Consume: ingreso publicitario confirmado (Publicidad), contenido publicado/restringido (Catálogo), compra de membresía o propina.\n- Emite: monetización habilitada/deshabilitada, ingreso atribuido a creador, pago procesado.",
    "contact": { "email": "monetizacion@youtube.example.com" },
    "license": { "name": "Apache 2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0.html" },
    "version": "1.0.0"
  },
  "servers": [ { "url": "/api/v1/monetizacion" } ],
  "tags": [
    { "name": "eligibility", "description": "Alta y elegibilidad (RF-M1)" },
    { "name": "products", "description": "Configuración de productos del creador (RF-M2)" },
    { "name": "earnings", "description": "Registro y consulta de ingresos (RF-M3, RF-M4)" },
    { "name": "payouts", "description": "Pagos al creador (RF-M5)" }
  ],
  "paths": {
    "/channels/{channelId}/monetization/applications": {
      "post": {
        "tags": ["eligibility"],
        "summary": "Solicitar monetización de un canal.",
        "description": "RF-M1: Permite a un creador solicitar monetizar su canal.",
        "operationId": "applyForMonetization",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "201": {
            "description": "Solicitud creada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MonetizationApplication" }
              }
            }
          },
          "409": { "description": "Ya existe una solicitud activa." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/monetization/eligibility": {
      "get": {
        "tags": ["eligibility"],
        "summary": "Consultar estado de elegibilidad.",
        "description": "RF-M1: Evalúa e informa el estado de elegibilidad (apto, pendiente, rechazado) según requisitos.",
        "operationId": "getEligibility",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Estado de elegibilidad.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EligibilityStatus" }
              }
            }
          },
          "404": { "description": "Canal no encontrado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/monetization/enable": {
      "post": {
        "tags": ["eligibility"],
        "summary": "Activar monetización a nivel canal.",
        "description": "RF-M1: Activa monetización a nivel canal cuando es elegible.",
        "operationId": "enableMonetization",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Monetización activada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MonetizationSettings" }
              }
            }
          },
          "409": { "description": "El canal no es elegible." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/monetization/disable": {
      "post": {
        "tags": ["eligibility"],
        "summary": "Desactivar monetización del canal.",
        "operationId": "disableMonetization",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Monetización desactivada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MonetizationSettings" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/content/{catalogItemId}/monetization": {
      "put": {
        "tags": ["eligibility"],
        "summary": "Activar o desactivar monetización a nivel contenido.",
        "description": "RF-M1: Permite activar/desactivar la monetización a nivel contenido.",
        "operationId": "setContentMonetization",
        "parameters": [
          {
            "name": "catalogItemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["enabled"],
                "properties": {
                  "enabled": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado de monetización del contenido actualizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentMonetization" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/memberships/tiers": {
      "post": {
        "tags": ["products"],
        "summary": "Definir nivel de membresía.",
        "description": "RF-M2: Permite definir niveles de membresía de canal (precio, beneficios).",
        "operationId": "createMembershipTier",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MembershipTierRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Nivel creado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MembershipTier" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      },
      "get": {
        "tags": ["products"],
        "summary": "Listar niveles de membresía del canal.",
        "operationId": "listMembershipTiers",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Niveles disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MembershipTier" }
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channelId}/tips/settings": {
      "put": {
        "tags": ["products"],
        "summary": "Configurar propinas/agradecimientos.",
        "description": "RF-M2: Permite gestionar propinas/agradecimientos en videos.",
        "operationId": "updateTipSettings",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TipSettings" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuración actualizada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TipSettings" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/purchases/memberships": {
      "post": {
        "tags": ["products"],
        "summary": "Registrar compra de membresía.",
        "description": "RF-M2: Registra cuando un espectador compra una membresía.",
        "operationId": "recordMembershipPurchase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MembershipPurchaseRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compra registrada y considerada como ingreso del creador.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MembershipPurchase" }
              }
            }
          },
          "400": { "description": "Datos inválidos." }
        },
        "security": [ { "bearerAuth": ["viewer", "service"] } ]
      }
    },
    "/purchases/tips": {
      "post": {
        "tags": ["products"],
        "summary": "Registrar propina dejada por un espectador.",
        "description": "RF-M2: Registra cuando un espectador deja una propina.",
        "operationId": "recordTip",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TipRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Propina registrada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tip" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["viewer", "service"] } ]
      }
    },
    "/revenues": {
      "post": {
        "tags": ["earnings"],
        "summary": "Registrar evento de ingreso.",
        "description": "RF-M3: Registra eventos de ingreso asociados a contenido y canal. Acepta ingresos originados por publicidad (vía Publicidad), membresías y propinas. Aplica reglas de reparto (revenue share).",
        "operationId": "recordRevenue",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RevenueEventRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ingreso registrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RevenueEvent" }
              }
            }
          },
          "400": { "description": "Datos inválidos." }
        },
        "security": [ { "bearerAuth": ["service"] } ]
      }
    },
    "/channels/{channelId}/earnings": {
      "get": {
        "tags": ["earnings"],
        "summary": "Consultar ganancias por periodo.",
        "description": "RF-M4: Permite consultar ganancias por periodo (día, mes, etc.) y desglose por video, fuente y métricas.",
        "operationId": "getEarnings",
        "parameters": [
          { "$ref": "#/components/parameters/ChannelIdParam" },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["day", "month"],
              "default": "month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen de ganancias.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EarningsReport" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/earnings/breakdown": {
      "get": {
        "tags": ["earnings"],
        "summary": "Desglose de ganancias por video, fuente y métricas.",
        "operationId": "getEarningsBreakdown",
        "parameters": [
          { "$ref": "#/components/parameters/ChannelIdParam" },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Desglose detallado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EarningsBreakdown" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/reports": {
      "post": {
        "tags": ["earnings"],
        "summary": "Generar reporte exportable.",
        "description": "RF-M4: Genera reportes exportables para el creador.",
        "operationId": "generateReport",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from", "to", "format"],
                "properties": {
                  "from": { "type": "string", "format": "date" },
                  "to": { "type": "string", "format": "date" },
                  "format": { "type": "string", "enum": ["csv", "pdf"] }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Reporte en generación.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportJob" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/balance": {
      "get": {
        "tags": ["payouts"],
        "summary": "Consultar saldo disponible del creador.",
        "description": "RF-M5: Mantiene y expone el saldo disponible del creador.",
        "operationId": "getBalance",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Saldo disponible.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Balance" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/payouts": {
      "post": {
        "tags": ["payouts"],
        "summary": "Solicitar retiro.",
        "description": "RF-M5: Permite solicitar un retiro cuando se supera el mínimo.",
        "operationId": "requestPayout",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PayoutRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud creada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Payout" }
              }
            }
          },
          "409": { "description": "Saldo insuficiente o mínimo no alcanzado." }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      },
      "get": {
        "tags": ["payouts"],
        "summary": "Listar historial de pagos.",
        "description": "RF-M5: Registra y expone historial de pagos realizados.",
        "operationId": "listPayouts",
        "parameters": [
          { "$ref": "#/components/parameters/ChannelIdParam" },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Historial de pagos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PayoutPage" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    },
    "/channels/{channelId}/tax-documents": {
      "post": {
        "tags": ["payouts"],
        "summary": "Cargar documentación fiscal.",
        "description": "RF-M5: Soporta la documentación fiscal requerida para cobrar.",
        "operationId": "uploadTaxDocument",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaxDocumentRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Documento cargado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaxDocument" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      },
      "get": {
        "tags": ["payouts"],
        "summary": "Listar documentos fiscales del canal.",
        "operationId": "listTaxDocuments",
        "parameters": [ { "$ref": "#/components/parameters/ChannelIdParam" } ],
        "responses": {
          "200": {
            "description": "Documentos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TaxDocument" }
                }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["creator"] } ]
      }
    }
  },
  "components": {
    "parameters": {
      "ChannelIdParam": {
        "name": "channelId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSizeParam": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "schemas": {
      "MonetizationApplication": {
        "type": "object",
        "properties": {
          "applicationId": { "type": "string" },
          "channelId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["submitted", "under_review", "approved", "rejected"]
          },
          "submittedAt": { "type": "string", "format": "date-time" },
          "decidedAt": { "type": "string", "format": "date-time" }
        }
      },
      "EligibilityStatus": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["eligible", "pending", "rejected"]
          },
          "subscribers": { "type": "integer" },
          "watchHours": { "type": "integer" },
          "policyCompliant": { "type": "boolean" },
          "missingRequirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "MonetizationSettings": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "enabled": { "type": "boolean" },
          "revenueSharePercent": { "type": "number", "format": "float" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ContentMonetization": {
        "type": "object",
        "properties": {
          "catalogItemId": { "type": "string" },
          "enabled": { "type": "boolean" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MembershipTier": {
        "type": "object",
        "properties": {
          "tierId": { "type": "string" },
          "channelId": { "type": "string" },
          "name": { "type": "string" },
          "monthlyPrice": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "benefits": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "MembershipTierRequest": {
        "type": "object",
        "required": ["name", "monthlyPrice", "currency"],
        "properties": {
          "name": { "type": "string" },
          "monthlyPrice": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "benefits": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "TipSettings": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "enabled": { "type": "boolean" },
          "minAmount": { "type": "number", "format": "float" },
          "currency": { "type": "string" }
        }
      },
      "MembershipPurchaseRequest": {
        "type": "object",
        "required": ["userId", "tierId"],
        "properties": {
          "userId": { "type": "string" },
          "tierId": { "type": "string" }
        }
      },
      "MembershipPurchase": {
        "type": "object",
        "properties": {
          "purchaseId": { "type": "string" },
          "userId": { "type": "string" },
          "channelId": { "type": "string" },
          "tierId": { "type": "string" },
          "amount": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "purchasedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TipRequest": {
        "type": "object",
        "required": ["userId", "channelId", "amount", "currency"],
        "properties": {
          "userId": { "type": "string" },
          "channelId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "amount": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "Tip": {
        "type": "object",
        "properties": {
          "tipId": { "type": "string" },
          "userId": { "type": "string" },
          "channelId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "amount": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "RevenueEventRequest": {
        "type": "object",
        "required": ["channelId", "source", "grossAmount", "currency"],
        "properties": {
          "channelId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["ad", "membership", "tip"]
          },
          "externalReferenceId": {
            "type": "string",
            "description": "ID del evento de origen (p. ej. impresión facturable de Publicidad)."
          },
          "grossAmount": { "type": "number", "format": "float" },
          "currency": { "type": "string" }
        }
      },
      "RevenueEvent": {
        "type": "object",
        "properties": {
          "revenueEventId": { "type": "string" },
          "channelId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["ad", "membership", "tip"]
          },
          "grossAmount": { "type": "number", "format": "float" },
          "creatorShare": { "type": "number", "format": "float" },
          "platformShare": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "confirmed", "paid"]
          },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "EarningsReport": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "granularity": { "type": "string", "enum": ["day", "month"] },
          "totalGross": { "type": "number", "format": "float" },
          "totalCreator": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "period": { "type": "string" },
                "gross": { "type": "number", "format": "float" },
                "creator": { "type": "number", "format": "float" }
              }
            }
          }
        }
      },
      "EarningsBreakdown": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "byVideo": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "catalogItemId": { "type": "string" },
                "creatorRevenue": { "type": "number", "format": "float" },
                "rpm": { "type": "number", "format": "float" }
              }
            }
          },
          "bySource": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": { "type": "string", "enum": ["ad", "membership", "tip"] },
                "creatorRevenue": { "type": "number", "format": "float" }
              }
            }
          }
        }
      },
      "ReportJob": {
        "type": "object",
        "properties": {
          "reportJobId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "ready", "failed"]
          },
          "downloadUrl": { "type": "string" }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "available": { "type": "number", "format": "float" },
          "pending": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "minimumWithdrawal": { "type": "number", "format": "float" }
        }
      },
      "PayoutRequest": {
        "type": "object",
        "required": ["amount", "currency", "method"],
        "properties": {
          "amount": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "method": {
            "type": "string",
            "enum": ["bank_transfer", "paypal", "other"]
          }
        }
      },
      "Payout": {
        "type": "object",
        "properties": {
          "payoutId": { "type": "string" },
          "channelId": { "type": "string" },
          "amount": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "method": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["requested", "processing", "completed", "failed"]
          },
          "requestedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PayoutPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Payout" }
          },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "TaxDocumentRequest": {
        "type": "object",
        "required": ["type", "country"],
        "properties": {
          "type": { "type": "string" },
          "country": { "type": "string" },
          "fileUrl": { "type": "string" }
        }
      },
      "TaxDocument": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string" },
          "channelId": { "type": "string" },
          "type": { "type": "string" },
          "country": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "validated", "rejected"]
          },
          "uploadedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
