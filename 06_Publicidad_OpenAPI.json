{
  "openapi": "3.0.4",
  "info": {
    "title": "YouTube - Publicidad y marketplace de anunciantes",
    "description": "## Responsabilidad\n\nGestionar el **negocio publicitario B2B**: campañas, inventario, targeting, entrega de anuncios e ingresos para la plataforma.\n\n## Alcance\n\n- **Sí:** anunciantes, campañas, creativos, decisiones de ad, impresiones, billing.\n- **No:** pagar al creador directamente (eso es Monetización), comentarios, recomendaciones.\n\nCliente principal: **anunciante**, no creador. Cuando se confirma una impresión pagada, se informa a Monetización para repartir ingresos al creador.\n\n## Integraciones\n\n- Consume: contenido publicado/restringido (Catálogo), señales de engagement o categoría (Audiencia / Descubrimiento) para brand safety.\n- Emite: anuncio servido, impresión facturable confirmada, ingreso publicitario generado (para Monetización), presupuesto de campaña agotado.",
    "contact": { "email": "publicidad@youtube.example.com" },
    "license": { "name": "Apache 2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0.html" },
    "version": "1.0.0"
  },
  "servers": [ { "url": "/api/v1/publicidad" } ],
  "tags": [
    { "name": "advertisers", "description": "Gestión de anunciantes (RF-F1)" },
    { "name": "campaigns", "description": "Campañas (RF-F2)" },
    { "name": "creatives", "description": "Creativos publicitarios (RF-F3)" },
    { "name": "targeting", "description": "Targeting (RF-F4)" },
    { "name": "inventory", "description": "Inventario publicitario (RF-F5)" },
    { "name": "delivery", "description": "Entrega de anuncios (RF-F6)" },
    { "name": "measurement", "description": "Medición (RF-F7)" },
    { "name": "reports", "description": "Reporting para anunciantes (RF-F8)" }
  ],
  "paths": {
    "/advertisers": {
      "post": {
        "tags": ["advertisers"],
        "summary": "Registrar cuenta de anunciante.",
        "description": "RF-F1: Permite registrar cuentas de anunciantes.",
        "operationId": "registerAdvertiser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdvertiserCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Anunciante creado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Advertiser" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiserAdmin"] } ]
      }
    },
    "/advertisers/{advertiserId}/billing": {
      "put": {
        "tags": ["advertisers"],
        "summary": "Actualizar datos de facturación.",
        "description": "RF-F1: Administra los datos de facturación del anunciante.",
        "operationId": "updateAdvertiserBilling",
        "parameters": [ { "$ref": "#/components/parameters/AdvertiserIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BillingInfo" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos actualizados.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BillingInfo" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/advertisers/{advertiserId}/campaigns": {
      "post": {
        "tags": ["campaigns"],
        "summary": "Crear campaña.",
        "description": "RF-F2: Permite crear campañas con objetivo, presupuesto y vigencia.",
        "operationId": "createCampaign",
        "parameters": [ { "$ref": "#/components/parameters/AdvertiserIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CampaignCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Campaña creada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Campaign" }
              }
            }
          },
          "400": { "description": "Datos inválidos." }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      },
      "get": {
        "tags": ["campaigns"],
        "summary": "Listar campañas del anunciante.",
        "operationId": "listCampaigns",
        "parameters": [
          { "$ref": "#/components/parameters/AdvertiserIdParam" },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Campañas.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CampaignPage" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/campaigns/{campaignId}/pause": {
      "post": {
        "tags": ["campaigns"],
        "summary": "Pausar campaña.",
        "operationId": "pauseCampaign",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "responses": {
          "200": {
            "description": "Campaña pausada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Campaign" }
              }
            }
          },
          "404": { "description": "Campaña no encontrada." }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/campaigns/{campaignId}/resume": {
      "post": {
        "tags": ["campaigns"],
        "summary": "Reanudar campaña.",
        "operationId": "resumeCampaign",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "responses": {
          "200": {
            "description": "Campaña reanudada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Campaign" }
              }
            }
          },
          "404": { "description": "Campaña no encontrada." }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/campaigns/{campaignId}/end": {
      "post": {
        "tags": ["campaigns"],
        "summary": "Finalizar campaña.",
        "operationId": "endCampaign",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "responses": {
          "200": {
            "description": "Campaña finalizada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Campaign" }
              }
            }
          },
          "404": { "description": "Campaña no encontrada." }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/campaigns/{campaignId}/creatives": {
      "post": {
        "tags": ["creatives"],
        "summary": "Subir y registrar creativo.",
        "description": "RF-F3: Permite subir y registrar creativos (video, display, etc.) y asociarlos a la campaña. Valida según políticas publicitarias.",
        "operationId": "addCreativeToCampaign",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreativeCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creativo registrado y en validación.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Creative" }
              }
            }
          },
          "400": { "description": "Datos inválidos." }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      },
      "get": {
        "tags": ["creatives"],
        "summary": "Listar creativos asociados a la campaña.",
        "operationId": "listCampaignCreatives",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "responses": {
          "200": {
            "description": "Creativos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Creative" }
                }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/campaigns/{campaignId}/targeting": {
      "put": {
        "tags": ["targeting"],
        "summary": "Definir criterios de segmentación.",
        "description": "RF-F4: Permite definir criterios de segmentación (país, edad, intereses, categoría de contenido, etc.).",
        "operationId": "setCampaignTargeting",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Targeting" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Targeting actualizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Targeting" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/targeting/inventory-estimate": {
      "post": {
        "tags": ["targeting"],
        "summary": "Estimar inventario disponible.",
        "description": "RF-F4: Estima inventario disponible según targeting.",
        "operationId": "estimateInventory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Targeting" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estimación de inventario.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryEstimate" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/inventory/eligibility/{catalogItemId}": {
      "get": {
        "tags": ["inventory"],
        "summary": "Consultar elegibilidad publicitaria de un contenido.",
        "description": "RF-F5: Determina si un contenido es elegible para mostrar anuncios. Respeta restricciones del catálogo (no monetizable, restringido, etc.).",
        "operationId": "checkAdEligibility",
        "parameters": [
          {
            "name": "catalogItemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Elegibilidad publicitaria.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdEligibility" }
              }
            }
          },
          "404": { "description": "Contenido desconocido." }
        }
      }
    },
    "/ads/decision": {
      "post": {
        "tags": ["delivery"],
        "summary": "Decidir qué anuncio mostrar ante una oportunidad de visualización.",
        "description": "RF-F6: Ante una oportunidad de visualización, decide qué anuncio mostrar (o ninguno) considerando campañas activas, targeting, subasta/prioridad y brand safety. Soporta pre-roll, mid-roll y display.",
        "operationId": "decideAd",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decisión de anuncio (puede ser 'sin anuncio').",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdDecision" }
              }
            }
          }
        },
        "security": [
          { "bearerAuth": ["viewer", "service"] },
          {}
        ]
      }
    },
    "/ads/events/impressions": {
      "post": {
        "tags": ["measurement"],
        "summary": "Registrar impresión servida.",
        "description": "RF-F7: Registra impresiones servidas y calcula gasto.",
        "operationId": "recordImpression",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdImpressionRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Impresión registrada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdImpression" }
              }
            }
          }
        }
      }
    },
    "/ads/events/clicks": {
      "post": {
        "tags": ["measurement"],
        "summary": "Registrar click en anuncio.",
        "description": "RF-F7: Registra clicks en anuncios.",
        "operationId": "recordAdClick",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdClickRequest" }
            }
          }
        },
        "responses": {
          "202": { "description": "Click registrado." }
        }
      }
    },
    "/ads/events/skips": {
      "post": {
        "tags": ["measurement"],
        "summary": "Registrar skip de anuncio.",
        "description": "RF-F7: Registra skips cuando aplique.",
        "operationId": "recordAdSkip",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdSkipRequest" }
            }
          }
        },
        "responses": {
          "202": { "description": "Skip registrado." }
        }
      }
    },
    "/campaigns/{campaignId}/metrics": {
      "get": {
        "tags": ["reports"],
        "summary": "Métricas de campaña.",
        "description": "RF-F8: Expone impresiones, CTR, CPM, gasto y otras métricas.",
        "operationId": "getCampaignMetrics",
        "parameters": [
          { "$ref": "#/components/parameters/CampaignIdParam" },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CampaignMetrics" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/campaigns/{campaignId}/reports": {
      "post": {
        "tags": ["reports"],
        "summary": "Generar reporte para anunciante.",
        "description": "RF-F8: Genera reportes para el anunciante.",
        "operationId": "generateCampaignReport",
        "parameters": [ { "$ref": "#/components/parameters/CampaignIdParam" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from", "to", "format"],
                "properties": {
                  "from": { "type": "string", "format": "date" },
                  "to": { "type": "string", "format": "date" },
                  "format": { "type": "string", "enum": ["csv", "pdf"] }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Reporte en generación.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportJob" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    },
    "/advertisers/{advertiserId}/invoices": {
      "get": {
        "tags": ["reports"],
        "summary": "Listar facturas del anunciante.",
        "description": "RF-F8: Genera invoices para el anunciante.",
        "operationId": "listInvoices",
        "parameters": [
          { "$ref": "#/components/parameters/AdvertiserIdParam" },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Facturas.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvoicePage" }
              }
            }
          }
        },
        "security": [ { "bearerAuth": ["advertiser"] } ]
      }
    }
  },
  "components": {
    "parameters": {
      "AdvertiserIdParam": {
        "name": "advertiserId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "CampaignIdParam": {
        "name": "campaignId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSizeParam": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "schemas": {
      "Advertiser": {
        "type": "object",
        "properties": {
          "advertiserId": { "type": "string" },
          "companyName": { "type": "string" },
          "country": { "type": "string" },
          "contactEmail": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AdvertiserCreateRequest": {
        "type": "object",
        "required": ["companyName", "country", "contactEmail"],
        "properties": {
          "companyName": { "type": "string" },
          "country": { "type": "string" },
          "contactEmail": { "type": "string" }
        }
      },
      "BillingInfo": {
        "type": "object",
        "properties": {
          "advertiserId": { "type": "string" },
          "billingAddress": { "type": "string" },
          "taxId": { "type": "string" },
          "paymentMethod": {
            "type": "string",
            "enum": ["credit_card", "bank_transfer", "other"]
          }
        }
      },
      "CampaignCreateRequest": {
        "type": "object",
        "required": ["name", "objective", "budget", "currency", "startDate", "endDate"],
        "properties": {
          "name": { "type": "string" },
          "objective": {
            "type": "string",
            "enum": ["awareness", "consideration", "conversion"]
          },
          "budget": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" }
        }
      },
      "Campaign": {
        "type": "object",
        "description": "Aquí el video se entiende como **slot publicitario / inventario**, no como producto editorial.",
        "properties": {
          "campaignId": { "type": "string" },
          "advertiserId": { "type": "string" },
          "name": { "type": "string" },
          "objective": {
            "type": "string",
            "enum": ["awareness", "consideration", "conversion"]
          },
          "budget": { "type": "number", "format": "float" },
          "spent": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "paused", "ended", "budget_exhausted"]
          }
        }
      },
      "CampaignPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Campaign" }
          },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "CreativeCreateRequest": {
        "type": "object",
        "required": ["type", "assetUrl"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["video", "display"]
          },
          "assetUrl": { "type": "string" },
          "durationSeconds": { "type": "integer" },
          "clickThroughUrl": { "type": "string" }
        }
      },
      "Creative": {
        "type": "object",
        "properties": {
          "creativeId": { "type": "string" },
          "campaignId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["video", "display"]
          },
          "assetUrl": { "type": "string" },
          "clickThroughUrl": { "type": "string" },
          "validationStatus": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"]
          }
        }
      },
      "Targeting": {
        "type": "object",
        "properties": {
          "countries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "minAge": { "type": "integer" },
          "maxAge": { "type": "integer" },
          "interests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contentCategories": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "InventoryEstimate": {
        "type": "object",
        "properties": {
          "estimatedDailyImpressions": { "type": "integer" },
          "estimatedReach": { "type": "integer" },
          "estimatedCpm": { "type": "number", "format": "float" },
          "currency": { "type": "string" }
        }
      },
      "AdEligibility": {
        "type": "object",
        "properties": {
          "catalogItemId": { "type": "string" },
          "eligible": { "type": "boolean" },
          "allowedFormats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["pre_roll", "mid_roll", "display"]
            }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "AdRequest": {
        "type": "object",
        "required": ["catalogItemId", "slot"],
        "properties": {
          "catalogItemId": { "type": "string" },
          "userId": { "type": "string" },
          "sessionId": { "type": "string" },
          "slot": {
            "type": "string",
            "enum": ["pre_roll", "mid_roll", "display"]
          },
          "country": { "type": "string" },
          "device": { "type": "string" }
        }
      },
      "AdDecision": {
        "type": "object",
        "properties": {
          "decisionId": { "type": "string" },
          "noAd": { "type": "boolean" },
          "campaignId": { "type": "string" },
          "creativeId": { "type": "string" },
          "slot": {
            "type": "string",
            "enum": ["pre_roll", "mid_roll", "display"]
          },
          "trackingTokens": {
            "type": "object",
            "properties": {
              "impressionToken": { "type": "string" },
              "clickToken": { "type": "string" },
              "skipToken": { "type": "string" }
            }
          }
        }
      },
      "AdImpressionRequest": {
        "type": "object",
        "required": ["decisionId"],
        "properties": {
          "decisionId": { "type": "string" },
          "impressionToken": { "type": "string" },
          "viewedSeconds": { "type": "integer" },
          "viewable": { "type": "boolean" }
        }
      },
      "AdImpression": {
        "type": "object",
        "properties": {
          "impressionId": { "type": "string" },
          "campaignId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "billable": { "type": "boolean" },
          "cost": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "AdClickRequest": {
        "type": "object",
        "required": ["decisionId"],
        "properties": {
          "decisionId": { "type": "string" },
          "clickToken": { "type": "string" }
        }
      },
      "AdSkipRequest": {
        "type": "object",
        "required": ["decisionId"],
        "properties": {
          "decisionId": { "type": "string" },
          "skipToken": { "type": "string" },
          "skippedAfterSeconds": { "type": "integer" }
        }
      },
      "CampaignMetrics": {
        "type": "object",
        "properties": {
          "campaignId": { "type": "string" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "impressions": { "type": "integer" },
          "clicks": { "type": "integer" },
          "ctr": { "type": "number", "format": "float" },
          "cpm": { "type": "number", "format": "float" },
          "spend": { "type": "number", "format": "float" },
          "currency": { "type": "string" }
        }
      },
      "ReportJob": {
        "type": "object",
        "properties": {
          "reportJobId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "ready", "failed"]
          },
          "downloadUrl": { "type": "string" }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "invoiceId": { "type": "string" },
          "advertiserId": { "type": "string" },
          "periodFrom": { "type": "string", "format": "date" },
          "periodTo": { "type": "string", "format": "date" },
          "amount": { "type": "number", "format": "float" },
          "currency": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["issued", "paid", "overdue"]
          },
          "issuedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InvoicePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Invoice" }
          },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
