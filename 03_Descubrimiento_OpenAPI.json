{
  "openapi": "3.0.4",
  "info": {
    "title": "YouTube - Descubrimiento y personalización",
    "description": "## Responsabilidad\n\nAyudar al usuario a **encontrar contenido relevante**: búsqueda, feeds, recomendaciones, tendencias y ranking.\n\n## Alcance\n\n- **Sí:** search, home feed, related, trending, señales de ranking.\n- **No:** almacenar comentarios, servir stream, pagar creadores, crear campañas.\n\nDevuelve **referencias a contenido**, no necesariamente toda la metadata ni el stream. No define reglas de visibilidad: respeta lo que indique Catálogo. El ranking y la personalización son responsabilidad exclusiva de este contexto.\n\n## Integraciones\n\n- Consume: contenido publicado/actualizado/restringido (Catálogo), engagement registrado (Audiencia), sesión de reproducción completada (Publicación).\n- Emite: búsqueda realizada, recomendación servida (opcional, analytics).",
    "contact": { "email": "descubrimiento@youtube.example.com" },
    "license": { "name": "Apache 2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0.html" },
    "version": "1.0.0"
  },
  "servers": [ { "url": "/api/v1/descubrimiento" } ],
  "tags": [
    { "name": "search", "description": "Búsqueda (RF-D1)" },
    { "name": "feeds", "description": "Feeds personalizados (RF-D2)" },
    { "name": "related", "description": "Contenido relacionado (RF-D3)" },
    { "name": "trending", "description": "Tendencias y exploración (RF-D4)" },
    { "name": "signals", "description": "Captura de señales (RF-D5)" },
    { "name": "index", "description": "Indexación (RF-D6)" }
  ],
  "paths": {
    "/search": {
      "get": {
        "tags": ["search"],
        "summary": "Buscar contenido por texto libre.",
        "description": "RF-D1: Busca contenido por texto libre, con filtros y ordenamiento. Devuelve referencias a contenido (no metadata completa).",
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Texto libre de búsqueda.",
            "schema": { "type": "string" }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Tipo de resultado.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["video", "channel", "all"],
              "default": "all"
            }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "durationBucket",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["short", "medium", "long"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["relevance", "date", "popularity"],
              "default": "relevance"
            }
          },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Resultados de búsqueda.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResultPage" }
              }
            }
          },
          "400": { "description": "Parámetros inválidos." }
        }
      }
    },
    "/search/suggestions": {
      "get": {
        "tags": ["search"],
        "summary": "Sugerencias mientras el usuario escribe.",
        "description": "RF-D1: Devuelve sugerencias de autocompletado.",
        "operationId": "getSearchSuggestions",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de sugerencias.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/feeds/home": {
      "get": {
        "tags": ["feeds"],
        "summary": "Obtener feed de inicio personalizado.",
        "description": "RF-D2: Genera un feed de inicio personalizado por usuario o sesión, con paginación.",
        "operationId": "getHomeFeed",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Feed personalizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeedPage" }
              }
            }
          }
        },
        "security": [
          { "bearerAuth": ["viewer"] },
          {}
        ]
      }
    },
    "/related/{catalogItemId}": {
      "get": {
        "tags": ["related"],
        "summary": "Obtener videos relacionados.",
        "description": "RF-D3: Dado un contenido, devuelve una lista de videos relacionados. Considera similitud temática, historial y señales de engagement.",
        "operationId": "getRelated",
        "parameters": [
          {
            "name": "catalogItemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Lista de relacionados.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeedPage" }
              }
            }
          },
          "404": { "description": "Contenido base no encontrado en el índice." }
        }
      }
    },
    "/trending": {
      "get": {
        "tags": ["trending"],
        "summary": "Contenido trending.",
        "description": "RF-D4: Devuelve contenido trending por región y/o categoría.",
        "operationId": "getTrending",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Lista trending.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeedPage" }
              }
            }
          }
        }
      }
    },
    "/explore/categories": {
      "get": {
        "tags": ["trending"],
        "summary": "Listar categorías para exploración.",
        "description": "RF-D4: Permite explorar por categoría o tema.",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "Categorías disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          }
        }
      }
    },
    "/explore/categories/{categoryId}": {
      "get": {
        "tags": ["trending"],
        "summary": "Contenido por categoría.",
        "operationId": "exploreCategory",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" }
        ],
        "responses": {
          "200": {
            "description": "Contenido de la categoría.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeedPage" }
              }
            }
          },
          "404": { "description": "Categoría no encontrada." }
        }
      }
    },
    "/signals/impressions": {
      "post": {
        "tags": ["signals"],
        "summary": "Registrar impresión.",
        "description": "RF-D5: Registra cuando un usuario ve un ítem en un feed (impresión).",
        "operationId": "recordImpression",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ImpressionSignal" }
            }
          }
        },
        "responses": {
          "202": { "description": "Señal aceptada." },
          "400": { "description": "Datos inválidos." }
        }
      }
    },
    "/signals/clicks": {
      "post": {
        "tags": ["signals"],
        "summary": "Registrar click en recomendación.",
        "description": "RF-D5: Registra cuando un usuario hace click en un ítem recomendado.",
        "operationId": "recordClick",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ClickSignal" }
            }
          }
        },
        "responses": {
          "202": { "description": "Señal aceptada." },
          "400": { "description": "Datos inválidos." }
        }
      }
    },
    "/signals/watch-time": {
      "post": {
        "tags": ["signals"],
        "summary": "Registrar tiempo de visualización.",
        "description": "RF-D5: Incorpora tiempo de visualización como señal de interés. Consumido también desde el evento de sesión completada de Publicación.",
        "operationId": "recordWatchTime",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WatchTimeSignal" }
            }
          }
        },
        "responses": {
          "202": { "description": "Señal aceptada." },
          "400": { "description": "Datos inválidos." }
        }
      }
    },
    "/profiles/{userId}/interests": {
      "get": {
        "tags": ["signals"],
        "summary": "Consultar perfil de intereses.",
        "description": "RF-D5: Devuelve el perfil de intereses del usuario, actualizado a partir de señales.",
        "operationId": "getInterestProfile",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil de intereses.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterestProfile" }
              }
            }
          },
          "404": { "description": "Usuario no encontrado." }
        },
        "security": [ { "bearerAuth": ["viewer"] } ]
      }
    },
    "/index/items": {
      "post": {
        "tags": ["index"],
        "summary": "Indexar contenido publicado.",
        "description": "RF-D6: Indexa contenido nuevo cuando es publicado en Catálogo. Normalmente invocado a partir del evento 'contenido publicado'.",
        "operationId": "indexItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IndexEntry" }
            }
          }
        },
        "responses": {
          "201": { "description": "Ítem indexado." },
          "400": { "description": "Datos inválidos." }
        },
        "security": [ { "bearerAuth": ["service"] } ]
      }
    },
    "/index/items/{catalogItemId}": {
      "patch": {
        "tags": ["index"],
        "summary": "Actualizar entrada del índice.",
        "description": "RF-D6: Actualiza el ítem en el índice cuando cambia su visibilidad o metadata indexable.",
        "operationId": "updateIndexEntry",
        "parameters": [
          {
            "name": "catalogItemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IndexEntry" }
            }
          }
        },
        "responses": {
          "200": { "description": "Ítem actualizado en el índice." },
          "404": { "description": "Ítem no encontrado en el índice." }
        },
        "security": [ { "bearerAuth": ["service"] } ]
      },
      "delete": {
        "tags": ["index"],
        "summary": "Remover ítem del índice.",
        "description": "RF-D6: Remueve el ítem del índice cuando deja de ser visible.",
        "operationId": "removeIndexEntry",
        "parameters": [
          {
            "name": "catalogItemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Ítem removido del índice." },
          "404": { "description": "Ítem no encontrado en el índice." }
        },
        "security": [ { "bearerAuth": ["service"] } ]
      }
    }
  },
  "components": {
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSizeParam": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "schemas": {
      "ContentRef": {
        "type": "object",
        "description": "Referencia ligera a contenido. Descubrimiento no guarda metadata completa; consultar Catálogo para detalles.",
        "properties": {
          "catalogItemId": { "type": "string" },
          "channelId": { "type": "string" },
          "title": { "type": "string" },
          "thumbnailUrl": { "type": "string" }
        }
      },
      "ChannelRef": {
        "type": "object",
        "properties": {
          "channelId": { "type": "string" },
          "name": { "type": "string" },
          "avatarUrl": { "type": "string" }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["video", "channel"] },
          "video": { "$ref": "#/components/schemas/ContentRef" },
          "channel": { "$ref": "#/components/schemas/ChannelRef" },
          "score": { "type": "number", "format": "float" }
        }
      },
      "SearchResultPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SearchResult" }
          },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "FeedItem": {
        "type": "object",
        "properties": {
          "video": { "$ref": "#/components/schemas/ContentRef" },
          "score": { "type": "number", "format": "float" },
          "reason": {
            "type": "string",
            "description": "Explicación interna (\"porque viste X\", \"trending en CL\")."
          }
        }
      },
      "FeedPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FeedItem" }
          },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "nextPageToken": { "type": "string" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "categoryId": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "ImpressionSignal": {
        "type": "object",
        "required": ["userId", "catalogItemId", "surface"],
        "properties": {
          "userId": { "type": "string" },
          "sessionId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "surface": {
            "type": "string",
            "enum": ["home", "search", "related", "trending", "explore"]
          },
          "position": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "ClickSignal": {
        "type": "object",
        "required": ["userId", "catalogItemId", "surface"],
        "properties": {
          "userId": { "type": "string" },
          "sessionId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "surface": {
            "type": "string",
            "enum": ["home", "search", "related", "trending", "explore"]
          },
          "position": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "WatchTimeSignal": {
        "type": "object",
        "required": ["userId", "catalogItemId", "secondsWatched"],
        "properties": {
          "userId": { "type": "string" },
          "catalogItemId": { "type": "string" },
          "secondsWatched": { "type": "integer" },
          "totalSeconds": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "InterestProfile": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "topic": { "type": "string" },
                "weight": { "type": "number", "format": "float" }
              }
            }
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "IndexEntry": {
        "type": "object",
        "required": ["catalogItemId"],
        "properties": {
          "catalogItemId": { "type": "string" },
          "channelId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "publishedAt": { "type": "string", "format": "date-time" },
          "visible": { "type": "boolean" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
